   "sources": [
    "https://raw.githubusercontent.com/GoogleCloudPlatform/ops-agent/master/apps/hostmetrics.go",
    "https://github.com/open-telemetry/opentelemetry-collector-contrib/blob/main/receiver/hostmetricsreceiver/internal/scraper/memoryscraper/documentation.md"
   ],
   "note": "a non-monotonic cumulative sum, which New Relic stores as a gauge; Google's state `slab` is slab_reclaimable plus slab_unreclaimable."

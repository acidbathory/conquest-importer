[
  {"ref": "cpu_high", "name": "[sample] 01 CPU high", "type": "metric alert",
   "query": "avg(last_5m):avg:system.cpu.user{*} > 90",
   "options": {"thresholds": {"critical": 90, "warning": 80}}},
  {"ref": "mem_high", "name": "[sample] 02 Memory usage high", "type": "metric alert",
   "query": "avg(last_10m):avg:system.mem.pct_usable{*} < 0.1",
   "options": {"thresholds": {"critical": 0.1}}},
  {"name": "[sample] 03 Disk usage high", "type": "metric alert",
   "query": "avg(last_15m):avg:system.disk.in_use{*} > 0.9",
   "options": {"thresholds": {"critical": 0.9}}},
  {"name": "[sample] 04 Load average high", "type": "metric alert",
   "query": "avg(last_5m):avg:system.load.5{*} > 4",
   "options": {"thresholds": {"critical": 4}}},
  {"name": "[sample] 05 CPU high by host", "type": "metric alert",
   "query": "avg(last_5m):avg:system.cpu.user{*} by {host} > 85",
   "options": {"thresholds": {"critical": 85}}},
  {"name": "[sample] 06 Network bytes received by host and device", "type": "metric alert",
   "query": "avg(last_10m):avg:system.net.bytes_rcvd{*} by {host,device} > 100000000",
   "options": {"thresholds": {"critical": 100000000}}},
  {"name": "[sample] 07 Max CPU over 15m", "type": "metric alert",
   "query": "max(last_15m):max:system.cpu.user{*} > 95",
   "options": {"thresholds": {"critical": 95}}},
  {"name": "[sample] 08 Min free swap over 1h", "type": "metric alert",
   "query": "min(last_1h):min:system.swap.free{*} < 100000000",
   "options": {"thresholds": {"critical": 100000000}}},
  {"name": "[sample] 09 Disk used percent (arithmetic)", "type": "metric alert",
   "query": "avg(last_10m):avg:system.disk.used{*} / avg:system.disk.total{*} * 100 > 90",
   "options": {"thresholds": {"critical": 90}}},
  {"name": "[sample] 10 HTTP error ratio (arithmetic, grouped)", "type": "query alert",
   "query": "sum(last_5m):sum:trace.http.request.errors{env:prod} by {service}.as_count() / sum:trace.http.request.hits{env:prod} by {service}.as_count() > 0.05",
   "options": {"thresholds": {"critical": 0.05}}},
  {"name": "[sample] 11 Error log volume", "type": "log alert",
   "query": "logs(\"status:error service:web\").index(\"*\").rollup(\"count\").last(\"5m\") > 50",
   "options": {"thresholds": {"critical": 50}, "enable_logs_sample": false}},
  {"name": "[sample] 12 Error logs grouped by service", "type": "log alert",
   "query": "logs(\"status:error\").index(\"*\").rollup(\"count\").by(\"service\").last(\"15m\") > 100",
   "options": {"thresholds": {"critical": 100}}},
  {"name": "[sample] 13 Agent heartbeat (service check)", "type": "service check",
   "query": "\"datadog.agent.up\".over(\"*\").by(\"host\").last(2).count_by_status()",
   "options": {"thresholds": {"critical": 1, "ok": 1}, "notify_no_data": true, "no_data_timeframe": 10}},
  {"name": "[sample] 14 APM error traces", "type": "trace-analytics alert",
   "query": "trace-analytics(\"service:web status:error\").index(\"trace-search\").rollup(\"count\").last(\"5m\") > 10",
   "options": {"thresholds": {"critical": 10}}},
  {"name": "[sample] 15 Warning and critical with recovery", "type": "metric alert",
   "query": "avg(last_10m):avg:system.cpu.system{*} > 80",
   "options": {"thresholds": {"critical": 80, "warning": 70, "critical_recovery": 60, "warning_recovery": 50}}},
  {"name": "[sample] 16 Notify on no data", "type": "metric alert",
   "query": "avg(last_5m):avg:custom.sample.metric{*} > 1",
   "options": {"thresholds": {"critical": 1}, "notify_no_data": true, "no_data_timeframe": 10}},
  {"ref": "composite", "name": "[sample] 17 Composite CPU and memory", "type": "composite",
   "query": "{ref:cpu_high} && {ref:mem_high}", "options": {}},
  {"name": "[sample] 18 Anomaly on CPU", "type": "query alert",
   "query": "avg(last_4h):anomalies(avg:system.cpu.user{*}, 'basic', 2, direction='both', alert_window='last_15m', interval=60, count_as_rate=false) >= 1",
   "options": {"thresholds": {"critical": 1, "critical_recovery": 0}}},
  {"name": "[sample] 19 Outlier and forecast variants", "type": "query alert",
   "query": "max(next_1w):forecast(avg:system.disk.in_use{*}, 'linear', 1, interval=60, history='1w', model='default') >= 0.9",
   "options": {"thresholds": {"critical": 0.9}}},
  {"name": "[sample] 20 Template variables and handles in message", "type": "metric alert",
   "query": "avg(last_5m):avg:system.cpu.user{*} by {host} > 90",
   "message": "CPU on {{host.name}} is {{value}} (threshold {{threshold}}). @pagerduty-sample",
   "options": {"thresholds": {"critical": 90}}}
]

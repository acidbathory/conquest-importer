# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# Datadog: use READ-ONLY keys (monitors_read scope) from a trial account.
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com

# New Relic: user key limited to alert write in the TEST account only.
NEW_RELIC_API_KEY=
NEW_RELIC_ACCOUNT_ID=

# Copy to .env in the folder you run `importer` from. .env is git-ignored. Never commit real keys.
# The importer reads this file itself; variables already set in your shell take priority.

# AWS: only needed here if you don't already have an AWS login or profile on this machine.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# New Relic: a User key (NRAK-...) that can manage alerts, dashboards and notifications.
# Only needed to create things; a plan doesn't use it.
NEW_RELIC_API_KEY=
# The account to migrate into. Try a test account first.
NEW_RELIC_ACCOUNT_ID=
# The accounts this tool may write to (comma-separated). It refuses any other account.
NEW_RELIC_ALLOWED_ACCOUNT_IDS=

# Dynatrace (extract-dynatrace): the tenant URL and a platform token that can read workflows and
# SLOs (scopes automation:workflows:read and slo:slos:read). Behind a TLS-inspecting proxy, set
# SSL_CERT_FILE to the corporate root certificate file.
DYNATRACE_ENV_URL=
DYNATRACE_API_TOKEN=

# Grafana (extract-grafana*, check-grafana-data): the stack address and a READ-ONLY service account
# token. The address must be https://<stack>.grafana.net unless you pass --allow-host.
GRAFANA_URL=
GRAFANA_SA_TOKEN=

# Google Cloud (extract-gcp): optional short-lived access token. Without it the importer uses
# `gcloud auth application-default login`.
GOOGLE_OAUTH_ACCESS_TOKEN=

[
  {
    "uid": "r-api",
    "title": "API latency high",
    "folderUID": "folder-uid-1",
    "ruleGroup": "group1",
    "condition": "C",
    "data": [
      {
        "refId": "A",
        "datasourceUid": "prom-main",
        "queryType": "",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "model": {
          "expr": "avg by (service) (request_latency_seconds)",
          "instant": true,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "queryType": "",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "model": {
          "type": "reduce",
          "expression": "A",
          "reducer": "mean",
          "refId": "B",
          "settings": {
            "mode": "dropNN"
          }
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "queryType": "",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "model": {
          "type": "threshold",
          "expression": "B",
          "refId": "C",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  1
                ]
              }
            }
          ]
        }
      }
    ],
    "for": "5m",
    "labels": {
      "severity": "critical",
      "team": "platform"
    },
    "annotations": {
      "summary": "API latency high"
    },
    "noDataState": "NoData",
    "execErrState": "Error",
    "isPaused": false
  },

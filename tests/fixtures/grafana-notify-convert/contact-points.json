[
  {
    "uid": "cp-email",
    "name": "Platform email",
    "type": "email",
    "settings": {
      "addresses": "EMAILADDR-platform@example.com; EMAILADDR-second@example.com"
    }
  },
  {
    "uid": "cp-email-bare",
    "name": "Data team",
    "type": "email",
    "settings": {
      "subject": "LEAK-subject {{ .CommonLabels.alertname }}"
    }
  },
  {
    "uid": "cp-hook",
    "name": "Generic hook",
    "type": "webhook",
    "settings": {
      "url": "https://hooks.example.com/LEAK-path?token=LEAK-query",
      "httpMethod": "PUT",
      "username": "LEAK-user",
      "password": "[REDACTED]",
      "authorization_credentials": "[REDACTED]",
      "headers": {
        "X-Api-Key": "LEAK-header"
      },
      "hmacConfig": {
        "secret": "[REDACTED]"
      },
      "payload": {
        "template": "{{ .Labels.password }} LEAK-payload"
      }
    },
    "disableResolveMessage": true
  },
  {
    "uid": "cp-slack",
    "name": "Slack alerts",
    "type": "slack",
    "settings": {
      "recipient": "#LEAK-channel",
      "token": "[REDACTED]",
      "url": "[REDACTED]"
    }
  },
  {
    "uid": "cp-pd",
    "name": "PagerDuty platform",

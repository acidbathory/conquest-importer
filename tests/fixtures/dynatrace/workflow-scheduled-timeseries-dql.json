{
  "description": "Hand-made test object, shaped like the real exports.",
  "id": "00000000-0000-0000-0000-000000000002",
  "isDeployed": true,
  "schemaVersion": 4,
  "tasks": {
    "check_cpu": {
      "action": "dynatrace.automations:execute-dql-query",
      "input": {
        "query": "timeseries cpu = avg(dt.host.cpu.usage), by:{dt.entity.host}, from:-10m | fieldsAdd high = cpu[] > 90"
      },
      "predecessors": []
    },
    "notify": {
      "action": "dynatrace.slack:slack-send-message",
      "conditions": {
        "custom": "{{ result(\"check_cpu\")[\"records\"][0][\"high\"] > 0 }}",
        "states": {
          "check_cpu": "OK"
        }
      },
      "input": {
        "channel": "#example",
        "message": "x"
      },
      "predecessors": [
        "check_cpu"
      ]
    }
  },
  "title": "example-cpu-check",
  "trigger": {
    "schedule": {
      "isActive": true,
      "timezone": "UTC",
      "trigger": {
        "intervalMinutes": 10,
        "type": "interval"
      }
    }
  },
  "triggerType": "Schedule",
  "type": "STANDARD",
  "version": 1
}

{
  "hand-made-folder": [
    {
      "name": "hand-made-group",
      "interval": "2m",
      "rules": [
        {
          "for": "10m",
          "keep_firing_for": "5m",
          "labels": {"team": "payments"},
          "annotations": {"summary": "hand made loki error count"},
          "grafana_alert": {
            "title": "hm-ruler-loki-errors",
            "condition": "C",
            "data": [
              {
                "refId": "A",
                "queryType": "",
                "relativeTimeRange": {"from": 300, "to": 0},
                "datasourceUid": "loki-main",
                "model": {
                  "refId": "A",
                  "datasource": {"type": "loki", "uid": "loki-main"},
                  "expr": "sum(count_over_time({app=\"checkout\"} |= \"timeout\" [5m]))",
                  "instant": true
                }
              },
              {
                "refId": "B",
                "datasourceUid": "__expr__",
                "relativeTimeRange": {"from": 0, "to": 0},
                "model": {"refId": "B", "type": "reduce", "expression": "A", "reducer": "last"}
              },
              {
                "refId": "C",
                "datasourceUid": "__expr__",
                "relativeTimeRange": {"from": 0, "to": 0},
                "model": {
                  "refId": "C",
                  "type": "threshold",
                  "expression": "B",
                  "conditions": [{"evaluator": {"type": "gt", "params": [20]}}]
                }
              }
            ],
            "uid": "hm-ruler-1",
            "namespace_uid": "hand-made-folder",
            "rule_group": "hand-made-group",
            "no_data_state": "Alerting",
            "exec_err_state": "Error",
            "is_paused": false,
            "intervalSeconds": 120,
            "version": 1,
            "provenance": ""
          }
        },
        {
          "for": "5m",
          "labels": {},
          "annotations": {},
          "grafana_alert": {
            "title": "hm-ruler-cloudwatch",
            "condition": "C",
            "data": [
              {
                "refId": "A",
                "relativeTimeRange": {"from": 600, "to": 0},
                "datasourceUid": "cw-main",
                "model": {
                  "refId": "A",
                  "datasource": {"type": "cloudwatch", "uid": "cw-main"},
                  "namespace": "AWS/EC2",
                  "metricName": "CPUUtilization",
                  "statistic": "Average"
                }
              },
              {
                "refId": "B",
                "datasourceUid": "__expr__",
                "model": {"refId": "B", "type": "reduce", "expression": "A", "reducer": "mean"}
              },
              {
                "refId": "C",
                "datasourceUid": "__expr__",
                "model": {
                  "refId": "C",
                  "type": "threshold",
                  "expression": "B",
                  "conditions": [{"evaluator": {"type": "gt", "params": [90]}}]
                }
              }
            ],
            "uid": "hm-ruler-2",
            "namespace_uid": "hand-made-folder",
            "rule_group": "hand-made-group",
            "no_data_state": "OK",
            "exec_err_state": "OK",
            "is_paused": false,
            "intervalSeconds": 120
          }
        },
        {
          "labels": {},
          "annotations": {},
          "grafana_alert": {
            "title": "hm-ruler-recording",
            "condition": "",
            "data": [
              {
                "refId": "A",
                "datasourceUid": "prom-main",
                "relativeTimeRange": {"from": 300, "to": 0},
                "model": {"refId": "A", "expr": "sum(rate(x_total[5m]))"}
              }
            ],
            "uid": "hm-ruler-3",
            "namespace_uid": "hand-made-folder",
            "rule_group": "hand-made-group",
            "record": {"metric": "x:rate5m", "from": "A", "target_datasource_uid": "prom-main"},
            "intervalSeconds": 120
          }
        }
      ]
    }
  ]
}

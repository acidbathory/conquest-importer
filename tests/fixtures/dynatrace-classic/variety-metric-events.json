  "items": [
    {
      "objectId": "SYNTH-ev-cpu",
      "schemaId": "builtin:anomaly-detection.metric-events",
      "scope": "environment",
      "value": {
        "enabled": true,
        "summary": "CPU above 90 on one host",
        "queryDefinition": {
          "type": "METRIC_KEY",
          "metricKey": "builtin:host.cpu.usage",
          "aggregation": "AVG",
          "entityFilter": {
            "dimensionKey": "dt.entity.host",
            "conditions": []
          },
          "dimensionFilter": [
            {
              "dimensionKey": "dt.entity.host",
              "operator": "EQUALS",
              "dimensionValue": "web-1"
            }
          ]
        },
        "modelProperties": {
          "type": "STATIC_THRESHOLD",
          "threshold": 90,
          "alertCondition": "ABOVE",
          "alertOnNoData": false,
          "violatingSamples": 3,
          "samples": 5,
          "dealertingSamples": 5
        },
        "eventTemplate": {
          "title": "CPU above 90 on one host",
          "description": "",
          "eventType": "RESOURCE"
        }
      }
    },

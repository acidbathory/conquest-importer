{
  "uid": "node-rows",
  "title": "Node exporter style",
  "schemaVersion": 39,
  "tags": [
    "fixture"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "value": "prom-main"
        }
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom-main"
        },
        "query": {
          "query": "label_values(node_uname_info, job)",
          "refId": "v"
        },
        "definition": "label_values(node_uname_info, job)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "value": [
            "$__all"
          ],
          "text": [
            "All"
          ]
        },
        "regex": ""
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom-main"
        },
        "query": {
          "query": "label_values(node_uname_info{job=~\"$job\"}, instance)",
          "refId": "v"
        },
        "definition": "label_values(node_uname_info{job=~\"$job\"}, instance)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {},
        "regex": "",
        "label": "Instance"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "name": "Annotations & Alerts",
        "enable": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "CPU and load",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU busy",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_cpu_seconds_total{job=~\"$job\", mode!=\"idle\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "fillOpacity": 10
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.8,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Load average",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(node_load1{job=~\"$job\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "1m"
        },
        {
          "refId": "B",
          "expr": "avg(node_load5{job=~\"$job\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "5m"
        },
        {
          "refId": "C",
          "expr": "avg(node_load15{job=~\"$job\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "15m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Memory",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{job=~\"$job\"} - node_memory_MemAvailable_bytes{job=~\"$job\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "Used"
        },
        {
          "refId": "B",
          "expr": "node_memory_MemAvailable_bytes{job=~\"$job\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "Available"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 70
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Memory used",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum(node_memory_MemAvailable_bytes{job=~\"$job\"}) / sum(node_memory_MemTotal_bytes{job=~\"$job\"}))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 70,
                "color": "orange"
              },
              {
                "value": 90,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Network",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 8,
          "type": "timeseries",
          "title": "Network receive",
          "gridPos": {
            "x": 0,
            "y": 20,
            "w": 12,
            "h": 7
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (device) (rate(node_network_receive_bytes_total{job=~\"$job\", device!=\"lo\"}[$__rate_interval]))",
              "datasource": {
                "type": "prometheus",
                "uid": "prom-main"
              },
              "legendFormat": "{{device}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "Bps"
            },
            "overrides": []
          }
        },
        {
          "id": 9,
          "type": "timeseries",
          "title": "Network transmit",
          "gridPos": {
            "x": 12,
            "y": 20,
            "w": 12,
            "h": 7
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (device) (rate(node_network_transmit_bytes_total{job=~\"$job\", device!~\"lo|veth.*\"}[$__rate_interval]))",
              "datasource": {
                "type": "prometheus",
                "uid": "prom-main"
              },
              "legendFormat": "{{device}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "Bps"
            },
            "overrides": []
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Disk",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Filesystems",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{job=~\"$job\", fstype!=\"tmpfs\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Largest filesystems used",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, sum by (mountpoint) (node_filesystem_size_bytes{job=~\"$job\"}))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "{{mountpoint}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Detail",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Per instance detail",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{instance=\"$instance\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "text",
      "title": "Notes",
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "options": {
        "mode": "markdown",
        "content": "Metrics come from node_exporter.\n\nSee the runbook."
      }
    }
  ]
}

{
  "uid": "k8s-vars",
  "title": "Kubernetes style with variables",
  "schemaVersion": 39,
  "tags": [
    "fixture"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "value": "prom-main"
        }
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom-main"
        },
        "query": {
          "query": "label_values(kube_pod_info, namespace)",
          "refId": "v"
        },
        "definition": "label_values(kube_pod_info, namespace)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "value": [
            "$__all"
          ]
        },
        "regex": ""
      },
      {
        "name": "cluster",
        "type": "custom",
        "query": "prod-eu,prod-us,staging",
        "multi": false,
        "includeAll": false,
        "options": [
          {
            "text": "prod-eu",
            "value": "prod-eu",
            "selected": true
          },
          {
            "text": "prod-us",
            "value": "prod-us",
            "selected": false
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          }
        ],
        "current": {
          "text": "prod-eu",
          "value": "prod-eu"
        }
      },
      {
        "name": "interval",
        "type": "interval",
        "query": "1m,5m,15m",
        "auto": true,
        "current": {
          "value": "5m"
        }
      },
      {
        "name": "region",
        "type": "constant",
        "query": "eu-west-1",
        "hide": 2
      },
      {
        "name": "jobfilter",
        "type": "textbox",
        "query": "kubelet",
        "current": {
          "value": "kubelet"
        }
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom-main"
        },
        "query": "label_values(kube_pod_info{namespace=~\"$namespace\"}, pod)",
        "multi": true
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "name": "Annotations & Alerts",
        "enable": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running pods",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\", phase=\"Running\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "pods",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU by pod",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", container!=\"\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory working set",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (container_memory_working_set_bytes{namespace=~\"$namespace\", container!=\"\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 50
          },
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Restarts",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[$interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request latency p99",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(http_request_duration_seconds_bucket{namespace=~\"$namespace\", cluster=\"$cluster\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "{{service}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Pods by phase",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase) (kube_pod_status_phase{namespace=~\"$namespace\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "{{phase}}",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Deployments not ready",
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment) (kube_deployment_spec_replicas{namespace=~\"$namespace\"}) - sum by (deployment) (kube_deployment_status_replicas_ready{namespace=~\"$namespace\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Error ratio",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{namespace=~\"$namespace\", code=~\"5..\"}[$__rate_interval])) / sum(rate(http_requests_total{namespace=~\"$namespace\"}[$__rate_interval])) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "5xx %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Region note",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{region=\"$region\", job=~\"$jobfilter\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "legendFormat": "up in $region"
        }
      ]
    }
  ]
}

{
  "apiVersion": "dashboard.grafana.app/v2beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "v2-small",
    "namespace": "default",
    "annotations": {
      "grafana.app/folder": "team-a"
    },
    "labels": {}
  },
  "spec": {
    "title": "Small v2 dashboard",
    "description": "Fixture written from the v2beta1 CUE schema (apps/dashboard/kinds/v2beta1), not exported from a stack.",
    "tags": [
      "fixture"
    ],
    "cursorSync": "Off",
    "editable": true,
    "liveNow": false,
    "preload": false,
    "links": [],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "1m",
      "autoRefreshIntervals": [
        "1m",
        "5m"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "annotations": [],
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "job",
          "label": "Job",
          "hide": "dontHide",
          "refresh": "onDashboardLoad",
          "skipUrlSync": false,
          "multi": true,
          "includeAll": true,
          "allowCustomValue": true,
          "regex": "",
          "sort": "alphabeticalAsc",
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "options": [],
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "prom-main"
            },
            "spec": {
              "expr": "label_values(up, job)"
            }
          }
        }
      },
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "mode",
          "hide": "dontHide",
          "skipUrlSync": false,
          "multi": false,
          "includeAll": false,
          "allowCustomValue": true,
          "query": "rate,total",
          "current": {
            "text": "rate",
            "value": "rate"
          },
          "options": []
        }
      }
    ],
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Targets up",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prom-main"
                      },
                      "spec": {
                        "expr": "sum(up{job=~\"$job\"})",
                        "instant": true
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.0.0",
            "spec": {
              "options": {
                "colorMode": "value"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 1,
                        "color": "green"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Memory",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prom-main"
                      },
                      "spec": {
                        "expr": "node_memory_MemAvailable_bytes{job=~\"$job\"}",
                        "legendFormat": "{{instance}}"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 300,
                "interval": "1m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.0.0",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "lib-1": {
        "kind": "LibraryPanel",
        "spec": {
          "id": 3,
          "title": "Shared CPU panel",
          "libraryPanel": {
            "uid": "lib-cpu-1",
            "name": "CPU by pod"
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Overview",
              "collapse": false,
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 8,
                        "height": 6,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-1"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 8,
                        "y": 0,
                        "width": 16,
                        "height": 6,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-2"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Shared",
              "collapse": true,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 2,
                  "columnWidthMode": "standard",
                  "rowHeightMode": "standard",
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "lib-1"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}

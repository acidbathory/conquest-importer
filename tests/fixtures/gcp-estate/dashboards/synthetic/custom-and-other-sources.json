{
 "displayName": "Non-Google-service metrics",
 "mosaicLayout": {
  "columns": 48,
  "tiles": [
   {
    "height": 16,
    "widget": {
     "title": "Queue depth",
     "xyChart": {
      "chartOptions": {
       "mode": "COLOR"
      },
      "dataSets": [
       {
        "plotType": "LINE",
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "aggregation": {
           "alignmentPeriod": "60s",
           "crossSeriesReducer": "REDUCE_NONE",
           "perSeriesAligner": "ALIGN_MAX"
          },
          "filter": "resource.type=\"global\" metric.type=\"custom.googleapis.com/app/queue_depth\""
         }
        }
       }
      ],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    },
    "width": 24,
    "xPos": 0,
    "yPos": 0
   },
   {
    "height": 16,
    "widget": {
     "title": "Agent memory",
     "xyChart": {
      "chartOptions": {
       "mode": "COLOR"
      },
      "dataSets": [
       {
        "plotType": "LINE",
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "aggregation": {
           "alignmentPeriod": "60s",
           "crossSeriesReducer": "REDUCE_NONE",
           "perSeriesAligner": "ALIGN_MEAN"
          },
          "filter": "resource.type=\"gce_instance\" metric.type=\"agent.googleapis.com/memory/percent_used\""
         }
        }
       }
      ],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    },
    "width": 24,
    "xPos": 24,
    "yPos": 0
   },
   {
    "height": 16,
    "widget": {
     "title": "GMP up",
     "xyChart": {
      "chartOptions": {
       "mode": "COLOR"
      },
      "dataSets": [
       {
        "plotType": "LINE",
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "aggregation": {
           "alignmentPeriod": "60s",
           "crossSeriesReducer": "REDUCE_NONE",
           "perSeriesAligner": "ALIGN_MEAN"
          },
          "filter": "resource.type=\"prometheus_target\" metric.type=\"prometheus.googleapis.com/up/gauge\""
         }
        }
       }
      ],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    },
    "width": 24,
    "xPos": 0,
    "yPos": 16
   },
   {
    "height": 16,
    "widget": {
     "title": "Log metric",
     "xyChart": {
      "chartOptions": {
       "mode": "COLOR"
      },
      "dataSets": [
       {
        "plotType": "LINE",
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "aggregation": {
           "alignmentPeriod": "60s",
           "crossSeriesReducer": "REDUCE_NONE",
           "perSeriesAligner": "ALIGN_DELTA"
          },
          "filter": "resource.type=\"global\" metric.type=\"logging.googleapis.com/user/checkout_errors\""
         }
        }
       }
      ],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    },
    "width": 24,
    "xPos": 24,
    "yPos": 16
   },
   {
    "height": 16,
    "widget": {
     "title": "Percentile 90",
     "xyChart": {
      "chartOptions": {
       "mode": "COLOR"
      },
      "dataSets": [
       {
        "plotType": "LINE",
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "aggregation": {
           "alignmentPeriod": "60s",
           "crossSeriesReducer": "REDUCE_NONE",
           "perSeriesAligner": "ALIGN_PERCENTILE_95"
          },
          "filter": "resource.type=\"https_lb_rule\" metric.type=\"loadbalancing.googleapis.com/https/total_latencies\""
         }
        }
       }
      ],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    },
    "width": 24,
    "xPos": 0,
    "yPos": 32
   },
   {
    "height": 16,
    "widget": {
     "title": "Regex filter",
     "xyChart": {
      "chartOptions": {
       "mode": "COLOR"
      },
      "dataSets": [
       {
        "plotType": "LINE",
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "aggregation": {
           "alignmentPeriod": "60s",
           "crossSeriesReducer": "REDUCE_NONE",
           "perSeriesAligner": "ALIGN_MEAN"
          },
          "filter": "resource.type=\"gce_instance\" metric.type=\"compute.googleapis.com/instance/cpu/utilization\" resource.label.zone=monitoring.regex.full_match(\"us-.*\")"
         }
        }
       }
      ],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    },
    "width": 24,
    "xPos": 24,
    "yPos": 32
   }
  ]
 }
}

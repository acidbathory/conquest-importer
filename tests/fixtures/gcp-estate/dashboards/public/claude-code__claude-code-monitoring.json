      "chartOptions": {
       "mode": "COLOR"
      },
      "dataSets": [
       {
        "legendTemplate": "sessions",
        "plotType": "LINE",
        "targetAxis": "Y1",
        "timeSeriesQuery": {
         "prometheusQuery": "sum(increase({\"__name__\"=\"claude_code.session.count\"}[${__interval}]))"
        }
       }
      ],
      "yAxis": {
       "label": "sessions",
       "scale": "LINEAR"

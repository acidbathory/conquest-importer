      "collapsed": false
     },
     "title": "Adoption"
    },
    "width": 48
   },
   {
    "height": 8,
    "widget": {
     "scorecard": {
      "blankView": {},
      "timeSeriesQuery": {
       "prometheusQuery": "sum(increase({\"__name__\"=\"claude_code.session.count\"}[30d]))"
      }
     },
     "title": "Sessions (30d)"
    },
    "width": 12
   },
   {
    "height": 8,
    "widget": {
     "scorecard": {
      "blankView": {},
      "timeSeriesQuery": {
       "prometheusQuery": "count(sum by (\"user.email\")(increase({\"__name__\"=\"claude_code.session.count\"}[30d])) > 0)"
      }
     },
     "title": "Active users (30d)"
    },
    "width": 12,
    "xPos": 12
   },
   {
    "height": 8,
    "widget": {
     "scorecard": {
      "blankView": {},
      "timeSeriesQuery": {
       "prometheusQuery": "sum(increase({\"__name__\"=\"claude_code.commit.count\"}[30d]))"

        "plotType": "LINE",
        "targetAxis": "Y1",
        "timeSeriesQuery": {
         "prometheusQuery": "count(sum by (\"user.email\")(increase({\"__name__\"=\"claude_code.session.count\"}[1d])) > 0)"

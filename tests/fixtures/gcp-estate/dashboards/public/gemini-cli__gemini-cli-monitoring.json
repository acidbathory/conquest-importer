    "height": 12,
    "widget": {
     "id": "",
     "title": "Code Assist Daily Active Users",
     "xyChart": {
      "chartOptions": {
       "displayHorizontal": false,
       "mode": "COLOR",
       "showLegend": false
      },
      "dataSets": [
       {
        "plotType": "LINE",
        "targetAxis": "Y1",
        "timeSeriesQuery": {
         "prometheusQuery": "label_replace(count(sum by (user_email) (increase({\"__name__\"=\"custom.googleapis.com/gemini_cli/gemini_cli.session.count\", \"monitored_resource\"=\"generic_node\",\"user_email\"=~\"^[a-zA-Z0-9][a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]*@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$\"}[1d])) > 0), \"metric_label\", \"Code Assist Daily Active Users\", \"\", \"\")"
        }
       }
      ],
      "thresholds": [],
      "yAxis": {
       "label": "unique users",
       "scale": "LINEAR"
      }
     }
    },
    "width": 12
   },

        "targetAxis": "Y1",
        "timeSeriesQuery": {
         "outputFullDuration": false,
         "prometheusQuery": "sum by (project_id, zone, instance_id, metadata_system_name) (\n  avg_over_time(\n    agent_googleapis_com:memory_percent_used{monitored_resource=\"gce_instance\", state=\"used\"}[${__interval}]\n  )\n)\nand on(project_id, zone, instance_id) (\n  workload_googleapis_com:wildfly_request_count{monitored_resource=\"gce_instance\"}\n)",
         "unitOverride": "%"
        }
       }
      ],
      "thresholds": [],
      "timeshiftDuration": "0s",
      "yAxis": {
       "label": "",

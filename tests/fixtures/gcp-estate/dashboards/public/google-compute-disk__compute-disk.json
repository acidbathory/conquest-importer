{
 "dashboardFilters": [
  {
   "filterType": "RESOURCE_LABEL",
   "labelKey": "project_id"
  },
  {
   "filterType": "RESOURCE_LABEL",
   "labelKey": "zone"
  },
  {
   "filterType": "RESOURCE_LABEL",
   "labelKey": "instance_id"
  }
 ],
 "displayName": "Disks",
 "mosaicLayout": {
  "columns": 48,
  "tiles": [
   {
    "height": 19,
    "widget": {
     "timeSeriesTable": {
      "columnSettings": [
       {
        "column": "device",
        "displayName": "Device",
        "visible": true
       },
       {
        "column": "value",
        "displayName": "Bytes Used",
        "visible": true
       },
       {
        "column": "system_labels.name",
        "displayName": "Disk",
        "visible": true
       },
       {
        "column": "instance_id",
        "visible": false
       },
       {
        "column": "project_id",
        "visible": false
       },
       {
        "column": "zone",
        "visible": false
       }
      ],
      "dataSets": [
       {
        "minAlignmentPeriod": "60s",
        "tableTemplate": "",
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "aggregation": {
           "alignmentPeriod": "60s",
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": [
            "resource.label.\"instance_id\"",
            "resource.label.\"project_id\"",
            "resource.label.\"zone\"",
            "metadata.system_labels.\"name\"",
            "metric.label.\"device\""
           ],
           "perSeriesAligner": "ALIGN_MEAN"
          },
          "filter": "metric.type=\"agent.googleapis.com/disk/bytes_used\" resource.type=\"gce_instance\""
         }
        }
       }
      ],
      "metricVisualization": "NUMBER",
      "opsAnalyticsSettings": {
       "maxRows": "0",
       "pageSize": "0",
       "showFilterBar": false
      }
     },
     "title": "Disks"
    },
    "width": 24
   },
   {
    "height": 16,
    "widget": {
     "incidentList": {
      "monitoredResources": [
       {
        "type": "gce_disk"
       }
      ],
      "policyNames": []
     },
     "title": "Incidents"
    },
    "width": 24,
    "yPos": 19
   },

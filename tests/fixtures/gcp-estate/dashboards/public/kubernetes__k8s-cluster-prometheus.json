    "height": 8,
    "widget": {
     "title": "Node CPU Usage",
     "xyChart": {
      "chartOptions": {
       "mode": "COLOR"
      },
      "dataSets": [
       {
        "breakdowns": [],
        "dimensions": [],
        "measures": [],
        "plotType": "LINE",
        "targetAxis": "Y1",
        "timeSeriesQuery": {
         "prometheusQuery": "100 - (avg by (instance) (irate(node_cpu_seconds_total{mode=\"idle\",${Cluster},${Location},${Namespace}}[${__interval}])) * 100)",
         "unitOverride": ""
        }
       }
      ],
      "thresholds": [],
      "timeshiftDuration": "0s",
      "yAxis": {
       "label": "y1Axis",
       "scale": "LINEAR"
      }
     }
    },
    "width": 24,
    "yPos": 20
   },

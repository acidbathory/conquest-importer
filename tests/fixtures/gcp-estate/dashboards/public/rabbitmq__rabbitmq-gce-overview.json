        "timeSeriesQuery": {
         "outputFullDuration": false,
         "prometheusQuery": "count by (region) (\n  label_replace(\n    sum by (project_id, zone, instance_id) (\n      count_over_time(workload_googleapis_com:rabbitmq_message_current{monitored_resource=\"gce_instance\"}[${__interval}])\n    ),\n    \"region\",\n    \"$1\",\n    \"zone\",\n    \"([^-]+-[^-]+)-.*\"\n  )\n)",
         "unitOverride": ""
        }
       }
      ],
      "thresholds": [],

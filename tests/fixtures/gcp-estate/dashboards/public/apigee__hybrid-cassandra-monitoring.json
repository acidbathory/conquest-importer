          "perSeriesAligner": "ALIGN_MEAN"
         },
         "filter": "metric.type=\"apigee.googleapis.com/cassandra/clientrequest_latency\" resource.type=\"k8s_container\" metric.label.\"scope\"=\"Write\" metric.label.\"unit\"=\"OneMinuteRate\""

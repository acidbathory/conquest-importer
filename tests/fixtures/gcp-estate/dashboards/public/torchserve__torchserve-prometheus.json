       "mode": "COLOR"
      },
      "dataSets": [
       {
        "plotType": "LINE",
        "targetAxis": "Y1",
        "timeSeriesQuery": {
         "prometheusQuery": "sum by (model_version,model_name)(rate(ts_inference_latency_microseconds[${__interval}]))",
         "unitOverride": "us"
        }

 ],
 "displayName": "TorchServe Prometheus Overview",
 "mosaicLayout": {
  "columns": 48,
  "tiles": [
   {
    "height": 16,
    "widget": {
     "title": "Requests by response code",
     "xyChart": {
      "chartOptions": {
       "displayHorizontal": false,
       "mode": "COLOR"
      },
      "dataSets": [
       {
        "legendTemplate": "2xx",
        "minAlignmentPeriod": "60s",
        "plotType": "STACKED_BAR",
        "targetAxis": "Y1",
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "aggregation": {
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": [],
           "perSeriesAligner": "ALIGN_RATE"
          },
          "filter": "metric.type=\"prometheus.googleapis.com/Requests2XX/counter\" resource.type=\"prometheus_target\""
         }
        }
       },
       {
        "legendTemplate": "4xx",
        "minAlignmentPeriod": "60s",
        "plotType": "STACKED_BAR",
        "targetAxis": "Y1",
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "aggregation": {
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": [],
           "perSeriesAligner": "ALIGN_RATE"
          },
          "filter": "metric.type=\"prometheus.googleapis.com/Requests4XX/counter\" resource.type=\"prometheus_target\""
         }
        }
       },
       {
        "legendTemplate": "5xx",
        "minAlignmentPeriod": "60s",
        "plotType": "STACKED_BAR",
        "targetAxis": "Y1",
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "aggregation": {
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": [],
           "perSeriesAligner": "ALIGN_RATE"
          },
          "filter": "metric.type=\"prometheus.googleapis.com/Requests5XX/counter\" resource.type=\"prometheus_target\""
         }
        }
       }
      ],
      "thresholds": [],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    },
    "width": 24,
    "yPos": 69
   },
   {
    "height": 4,
    "widget": {
     "sectionHeader": {
      "dividerBelow": false,
      "subtitle": "Inspect the rate at which the model server is handling requests and processing tokens."
     },
     "title": "Throughput"
    },
    "width": 48,
    "yPos": 9
   },
   {
    "height": 4,
    "widget": {
     "sectionHeader": {
      "dividerBelow": false,

{
 "alertStrategy": {
  "autoClose": "604800s",
  "notificationPrompts": [
   "OPENED",
   "CLOSED"
  ]
 },
 "combiner": "OR",
 "conditions": [
  {
   "conditionPrometheusQueryLanguage": {
    "duration": "0s",
    "evaluationInterval": "30s",
    "query": "sum by (job_id, state) (\n  {\"dataproc.googleapis.com/job/state\", monitored_resource=\"cloud_dataproc_job\", state=\"ERROR\"}\n) > 0"
   },
   "displayName": "Dataproc Failed Job - Job in ERROR state"
  }
 ],
 "displayName": "Dataproc Failed Job - Job in ERROR state",
 "enabled": true,
 "notificationChannels": [],
 "severity": "SEVERITY_UNSPECIFIED",
 "userLabels": {}
}

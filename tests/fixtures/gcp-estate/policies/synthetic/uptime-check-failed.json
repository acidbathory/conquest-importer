{
 "alertStrategy": {
  "autoClose": "1800s"
 },
 "combiner": "OR",
 "conditions": [
  {
   "conditionThreshold": {
    "aggregations": [
     {
      "alignmentPeriod": "1200s",
      "crossSeriesReducer": "REDUCE_COUNT_FALSE",
      "groupByFields": [
       "resource.label.host"
      ],
      "perSeriesAligner": "ALIGN_NEXT_OLDER"
     }
    ],
    "comparison": "COMPARISON_GT",
    "duration": "60s",
    "filter": "resource.type = \"uptime_url\" AND metric.type = \"monitoring.googleapis.com/uptime_check/check_passed\" AND metric.label.check_id = \"site-health\"",
    "thresholdValue": 1,
    "trigger": {
     "count": 1
    }
   },
   "displayName": "Uptime failed"
  }
 ],
 "displayName": "Site down",
 "documentation": {
  "content": "The health check failed from more than one region.",
  "mimeType": "text/markdown",
  "subject": "[${policy.display_name}] ${metric.display_name}"
 },
 "enabled": true,
 "notificationChannels": [
  "projects/example-project/notificationChannels/1001",
  "projects/example-project/notificationChannels/1005",
  "projects/example-project/notificationChannels/1010"
 ],
 "severity": "CRITICAL",
 "userLabels": {}
}

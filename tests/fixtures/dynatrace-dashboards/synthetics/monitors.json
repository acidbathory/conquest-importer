{
  "monitors": [
    {"entityId": "HTTP_CHECK-0000000000000001", "name": "Home page ping", "type": "HTTP", "enabled": true,
     "frequencyMin": 5, "locations": ["GEOLOCATION-0000000000000001", "GEOLOCATION-0000000000000002"],
     "script": {"version": "1.0", "requests": [{"description": "home", "url": "https://shop.example.invalid/",
       "method": "GET",
       "validation": {"rules": [{"type": "patternConstraint", "passIfFound": true, "value": "Welcome"}]},
       "configuration": {"acceptAnyCertificate": false, "followRedirects": true,
                         "requestHeaders": [{"name": "X-Probe", "value": "dt"}]}}]},
     "anomalyDetection": {"outageHandling": {"globalOutage": true, "globalOutagePolicy": {"consecutiveRuns": 1}},
                          "loadingTimeThresholds": {"enabled": true, "thresholds": [{"type": "TOTAL", "valueMs": 3000}]}}},
    {"entityId": "HTTP_CHECK-0000000000000002", "name": "Certificate expiry", "type": "HTTP", "enabled": true,
     "frequencyMin": 60, "locations": ["GEOLOCATION-0000000000000001"],
     "script": {"version": "1.0", "requests": [{"url": "https://api.example.invalid/", "method": "GET",
       "validation": {"rules": [{"type": "certificateExpiryDateConstraint", "value": "30"}]}}]}},
    {"entityId": "HTTP_CHECK-0000000000000003", "name": "Login POST", "type": "HTTP", "enabled": true,
     "frequencyMin": 10, "locations": ["GEOLOCATION-0000000000000001"],
     "script": {"version": "1.0", "requests": [{"url": "https://api.example.invalid/login", "method": "POST",
       "requestBody": "{\"user\":\"probe\"}"}]}},
    {"entityId": "HTTP_CHECK-0000000000000004", "name": "Two step API", "type": "HTTP", "enabled": true,
     "frequencyMin": 15, "locations": ["GEOLOCATION-0000000000000001"],
     "script": {"version": "1.0", "requests": [
       {"url": "https://api.example.invalid/a", "method": "GET"},
       {"url": "https://api.example.invalid/b", "method": "GET"}]}},
    {"entityId": "HTTP_CHECK-0000000000000005", "name": "Status list", "type": "HTTP", "enabled": true,
     "frequencyMin": 30, "locations": ["GEOLOCATION-0000000000000002"],
     "script": {"version": "1.0", "requests": [{"url": "https://api.example.invalid/s", "method": "GET",
       "validation": {"rules": [{"type": "httpStatusesList", "passIfFound": true, "value": ">=400"}]}}]}},
    {"entityId": "HTTP_CHECK-0000000000000006", "name": "With pre-processing", "type": "HTTP", "enabled": false,
     "frequencyMin": 5, "locations": ["SYNTHETIC_LOCATION-0000000000000009"],
     "script": {"version": "1.0", "requests": [{"url": "https://api.example.invalid/p", "method": "GET",
       "preProcessingScript": "api.setValue('a', 1);"}]}},
    {"entityId": "SYNTHETIC_TEST-0000000000000007", "name": "Landing availability", "type": "BROWSER", "enabled": true,
     "frequencyMin": 15, "locations": ["GEOLOCATION-0000000000000003"],
     "script": {"type": "availability", "version": "1.0",
       "configuration": {"device": {"deviceName": "Desktop", "orientation": "landscape"}},
       "events": [{"type": "navigate", "url": "https://shop.example.invalid/"}]}},
    {"entityId": "SYNTHETIC_TEST-0000000000000008", "name": "Checkout clickpath", "type": "BROWSER", "enabled": true,
     "frequencyMin": 30, "locations": ["GEOLOCATION-0000000000000003"],
     "script": {"type": "clickpath", "version": "1.0",
       "configuration": {"device": {"deviceName": "Apple iPhone 12", "orientation": "portrait"}},
       "events": [
         {"type": "navigate", "url": "https://shop.example.invalid/"},
         {"type": "click", "target": {"locators": [{"type": "css", "value": "#buy"}]}},
         {"type": "keystrokes", "textValue": "probe", "target": {"locators": [{"type": "css", "value": "#q"}]}}]}},
    {"entityId": "SYNTHETIC_TEST-0000000000000009", "name": "Clickpath with script", "type": "BROWSER", "enabled": true,
     "frequencyMin": 60, "locations": ["GEOLOCATION-0000000000000003"],
     "script": {"type": "clickpath", "version": "1.0",
       "events": [
         {"type": "navigate", "url": "https://shop.example.invalid/"},
         {"type": "javascript", "javaScript": "return 1;"}]}},
    {"entityId": "SYNTHETIC_TEST-000000000000000A", "name": "Cookie clickpath", "type": "BROWSER", "enabled": true,
     "frequencyMin": 60, "locations": ["GEOLOCATION-0000000000000003"],
     "script": {"type": "clickpath", "version": "1.0", "cookies": [{"name": "a", "value": "b", "domain": "x.invalid"}],
       "events": [{"type": "navigate", "url": "https://shop.example.invalid/"}]}},
    {"entityId": "NETWORK_AVAILABILITY_MONITOR-000000000000000B", "name": "DNS probe", "type": "NETWORK_AVAILABILITY",
     "enabled": true, "frequencyMin": 5, "locations": ["GEOLOCATION-0000000000000001"]},
    {"entityId": "HTTP_CHECK-000000000000000C", "name": "Odd frequency", "type": "HTTP", "enabled": true,
     "frequencyMin": 7, "locations": ["GEOLOCATION-0000000000000004"],
     "script": {"version": "1.0", "requests": [{"url": "https://api.example.invalid/f", "method": "GET"}]}},
    "not a monitor",
    {"name": "no type"}
  ]

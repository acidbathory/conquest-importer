      "version": "KqlParameterItem/1.0",
      "name": "Resources",
      "label": "Azure Managed Instance for Apache Cassandra",
      "type": 5,
      "isRequired": true,
      "value": "value::1",
      "isHiddenWhenLocked": true,
      "typeSettings": {
       "additionalResourceOptions": [
        "value::1"
       ]
